# Local-only configuration requested by the user. Change this password before exposing the database.
DB_PASSWORD=moneyflow

# Cau hinh email khôi phuc mat khau: can mot tai khoan SMTP that
# Gmail: can bat xac minh 2 buoc va tao App Password trong Google Account.
# Khong commit file .env len git hoac chia se cho nguoi khac.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
